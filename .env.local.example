NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Popup providers to show on /login, in order. Each must also be enabled in the Firebase console.
# Options: google, github, microsoft, apple, facebook, twitter, yahoo. Unset = google only.
# Email + password is always on (enable Email/Password in Firebase Auth → Sign-in method).
NEXT_PUBLIC_AUTH_PROVIDERS=google

# JSON string of the Firebase service account (Project settings → Service accounts → Generate key)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Postgres (Vercel/Neon sets this automatically on the deployment)
DATABASE_URL=
# Comma-separated accounts allowed into the lessons. Unset = any Google account.
ALLOWED_EMAILS=

# Paid access. Unset BILLING_ENABLED = today's behaviour: every signed-in account gets everything.
BILLING_ENABLED=
# Paddle Billing (merchant of record — it collects the VAT and issues the invoice).
# PADDLE_ENV=production for live keys; anything else (or unset) uses the sandbox API.
PADDLE_ENV=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# One-time, VAT-inclusive ILS prices created in the Paddle dashboard: 99 / 149 / 50.
PADDLE_PRICE_BASIC=
PADDLE_PRICE_ADVANCED=
PADDLE_PRICE_UPGRADE=

# Welcome email on first sign-in, via Resend. Unset = no email. The sender's domain must be
# verified in Resend (DNS records go in Vercel → Domains → vibetodev.com).
RESEND_API_KEY=
EMAIL_FROM="Vibe → Code <hello@vibetodev.com>"
